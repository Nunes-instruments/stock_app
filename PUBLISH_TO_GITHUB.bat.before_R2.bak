@echo off
setlocal EnableExtensions EnableDelayedExpansion
cd /d "%~dp0"
title NUNES Stock v3.2.11 - Publish to GitHub Main
set "REPO=https://github.com/Nunes-instruments/stock_app.git"
set "TEMP_REPO=%TEMP%\NunesStock_v3211_Publish"
set "RUNTIME=%LOCALAPPDATA%\NunesStockRuntimeV31\venv\Scripts\python.exe"
set "PREFLIGHT_DATA=%TEMP%\NunesStock_v3211_publish_preflight_data"

echo ============================================================
echo  NUNES STOCK v3.2.11 - SAFE GITHUB MAIN PUBLISH
echo ============================================================
echo Repository : %REPO%
echo Version    : 3.2.11
echo Data files : NEVER PUBLISHED
echo Force push : NEVER USED
echo ============================================================
where git >nul 2>&1 || (echo ERROR: Git for Windows is required.& pause & exit /b 1)

if exist "%TEMP_REPO%" rmdir /s /q "%TEMP_REPO%"
if exist "%PREFLIGHT_DATA%" rmdir /s /q "%PREFLIGHT_DATA%"

echo [1/6] Cloning current GitHub main...
git clone "%REPO%" "%TEMP_REPO%"
if errorlevel 1 goto :FAIL

echo [2/6] Overlaying tested v3.2.11 code while preserving extra remote files...
robocopy "%~dp0" "%TEMP_REPO%" /E /R:1 /W:1 /XD ".git" "__pycache__" ".venv" "venv" "data" "backups" /XF "*.db" "*.db-shm" "*.db-wal" "Master_Stock*.xlsx" "*.log" "*.zip" "*.rar" >nul
if errorlevel 8 goto :FAIL

echo [3/6] Verifying no business data is staged...
pushd "%TEMP_REPO%"
git add -A
for /f "delims=" %%F in ('git diff --cached --name-only') do (
  echo %%F| findstr /I /R "\.db$ \.db-shm$ \.db-wal$ Master_Stock .*backups/ .*data/" >nul && (
    echo ERROR: Runtime/business data would be published: %%F
    popd
    goto :FAIL
  )
)

echo [4/6] Running source and production preflight...
if exist "%RUNTIME%" (
  "%RUNTIME%" -m compileall -q .
  if errorlevel 1 (popd & goto :FAIL)
  set "NUNES_STOCK_DATA_DIR=%PREFLIGHT_DATA%"
  "%RUNTIME%" scripts\preflight.py
  if errorlevel 1 (popd & goto :FAIL)
) else (
  py -3 -m compileall -q . >nul 2>&1
  if errorlevel 1 (popd & goto :FAIL)
  echo WARNING: Full Flask preflight requires the installed NUNES runtime.
)

echo [5/6] Creating release commit...
git config user.name "Nunes Instruments Stock Server"
git config user.email "stock-server@nunes.local"
git diff --cached --quiet
if errorlevel 1 (
  git commit -m "NUNES Stock v3.2.11 - Shared clients and persistent Shelf Rack"
  if errorlevel 1 (popd & goto :FAIL)
) else (
  echo No code changes to publish.
)

echo [6/6] Pushing normal fast-forward update to main...
git push origin HEAD:main
if errorlevel 1 (popd & goto :FAIL)
popd

if exist "%TEMP_REPO%" rmdir /s /q "%TEMP_REPO%"
if exist "%PREFLIGHT_DATA%" rmdir /s /q "%PREFLIGHT_DATA%"
echo.
echo ============================================================
echo  PUBLISH COMPLETE
echo  GitHub main now contains NUNES Stock v3.2.11.
echo  The main server checks GitHub silently every 5 minutes.
echo ============================================================
pause
exit /b 0

:FAIL
if exist "%PREFLIGHT_DATA%" rmdir /s /q "%PREFLIGHT_DATA%" >nul 2>&1
echo.
echo [ERROR] Publish stopped. No force push was attempted.
echo Current live stock database was not changed.
if exist "%TEMP_REPO%" echo Temporary clone: %TEMP_REPO%
pause
exit /b 1
